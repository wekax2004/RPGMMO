# Normalize text files to LF in the repo, check out per-platform.
* text=auto eol=lf

# Windows batch files must keep CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.wav binary
*.ttf binary
*.woff binary
*.woff2 binary
